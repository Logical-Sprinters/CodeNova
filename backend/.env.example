# Copy this file to backend/.env. NEVER commit/share the completed .env.
# Default: working local SQLite + server-side password login. No cloud key required.
AUTH_PROVIDER=local
SEED_DEMO_USERS=true
# JWT_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=sqlite:///absolute/path/brandguard.sqlite3

# SUPABASE mode: configure ALL of these, then run the supplied SQL migration.
# AUTH_PROVIDER=supabase
# SEED_DEMO_USERS=false
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Run the launcher or Uvicorn from backend/ so this bundled PUBLIC CA path resolves.
# For another working directory/container, use an absolute server-side sslrootcert path.
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt&connect_timeout=10
# SUPABASE_STORAGE_BUCKET=brandguard-files
# AUTH_REDIRECT_URL=https://YOUR_BACKEND_DOMAIN/auth/reset
# Add that exact URL to Supabase Authentication > URL Configuration > Redirect URLs.
# Optional SERVER-ONLY admin key for manage.py create-user; NEVER in Flutter.
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_OR_LEGACY_SERVICE_ROLE_KEY

# Real grounded AI: disabled until YOUR provider access is configured.
AI_PROVIDER=disabled
# AI_PROVIDER=openai
# AI_API_KEY=YOUR_PROVIDER_SECRET
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.4-mini
# Optional absolute path if Tesseract OCR is not on the server PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Calls occur only when enabled AND relevant reviewer-verified facts exist.
# HTTPS deployed frontend origins, comma separated. Localhost development is allowed.
CORS_ORIGINS=

# Antideploy hosted option (native encrypted variables; do NOT embed these in Flutter).
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-5.4-mini
# OPENROUTER_API_KEY is injected by Antideploy; activation also requires wallet credit.
# PUBLIC_APP_URL=https://YOUR_APP.antideploy.app
# Signed Supabase Send Email Hook + native transactional email relay:
# SUPABASE_EMAIL_HOOK_SECRET=whsec_BASE64_RANDOM_SECRET
# RESEND_API_KEY and RESEND_API_URL / EMAIL_FROM are injected by Antideploy.
