{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandguard.local/contracts/rule.schema.json",
  "title": "Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "type",
    "text",
    "source",
    "version",
    "status",
    "effective_from",
    "expires_on",
    "supersedes",
    "risk_tier",
    "channels",
    "confirmed_by"
  ],
  "properties": {
    "rule_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["fact", "term", "tone", "claim", "visual"]
    },
    "text": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "page"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "page": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "SUPERSEDED", "EXPIRED"]
    },
    "effective_from": { "type": "string", "format": "date" },
    "expires_on": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule_id", "version"],
          "properties": {
            "rule_id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "risk_tier": { "type": "string", "enum": ["standard", "high"] },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "confirmed_by": {
      "oneOf": [
        { "type": "string", "format": "uuid" },
        { "type": "null" }
      ]
    }
  }
}
